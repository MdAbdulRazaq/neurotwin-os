# ── NEUROTWIN OS — Environment Variables ──────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── App ───────────────────────────────────────────────────────────────────────
DEBUG=false
SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_256_BIT_KEY
ALLOWED_ORIGINS=http://localhost:3000,https://app.neurotwin.ai

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://neurotwin:password@localhost:5432/neurotwin_db

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Neo4j ─────────────────────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password

# ── LLM (at least one required) ───────────────────────────────────────────────
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# ── Embeddings ────────────────────────────────────────────────────────────────
EMBEDDING_MODEL=text-embedding-3-small

# ── Vector DB ─────────────────────────────────────────────────────────────────
PINECONE_API_KEY=pcsk_...
PINECONE_ENVIRONMENT=us-east1-gcp
PINECONE_INDEX_NAME=neurotwin-memory

# ── Speech ────────────────────────────────────────────────────────────────────
STT_PROVIDER=deepgram
DEEPGRAM_API_KEY=...
TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=...
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# ── Storage ───────────────────────────────────────────────────────────────────
S3_ENDPOINT=https://s3.amazonaws.com
S3_BUCKET=neurotwin-media
S3_ACCESS_KEY=...
S3_SECRET_KEY=...

# ── Monitoring ────────────────────────────────────────────────────────────────
SENTRY_DSN=https://...@sentry.io/...
LOG_LEVEL=INFO
